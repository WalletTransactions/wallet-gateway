# Куда роутить /auth/*, /admin/*. Отсюда же гейтвей тянет публичные ключи
# (GET /.well-known/jwks.json) для проверки подписи access-токена на
# защищённых префиксах (/api/*) — никакого общего секрета заводить не нужно
# (раньше был JWT_SECRET — см. README.md, "Как убрали общий секрет").
AUTH_SERVICE_URL=http://127.0.0.1:8080

# Куда роутить /api/* (кроме /api/reports/*, см. WALLET_REPORT_API_URL ниже)
# — сервис ведения кошельков, со своей БД (см. его README).
WALLET_API_URL=http://127.0.0.1:8082

# Куда роутить /api/reports/* — вынесенный CQRS-lite query-сервис (та же
# база, что у WALLET_API_URL выше, но единственная read-only роль, см. его
# README, "Шареная БД, разные роли").
WALLET_REPORT_API_URL=http://127.0.0.1:8084

# Куда роутить всё остальное (фолбэк по умолчанию) — статика SPA, отдаёт
# nginx (см. README wallet-web). Раньше здесь был WALLET_BFF_URL — сервис
# упразднён при переходе на SPA.
WALLET_WEB_URL=http://127.0.0.1:8083

# Публичный порт самого гейтвея — это и есть тот единственный origin,
# который теперь должен открывать браузер (вместо прямых 8080/8082/8083).
PORT=8090
HOST=127.0.0.1

# Куда писать логи — папка, внутри неё файл на каждый день
# ("<LOG_DIR>/2026-08-24-wallet-gateway.log", ротация — по смене даты). По
# умолчанию (если не задано):
#   Windows — папка "logs" в рабочей директории;
#   Linux/Docker — stdout/stderr.
# LOG_DIR=var/log/wallet-gateway
# LOG_DIR=stdout
